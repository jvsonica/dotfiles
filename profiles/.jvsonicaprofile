# Preferred editor for local and remote sessions
export EDITOR='nvim'
export VISUAL='nvim'
export GIT_EDITOR='nvim'

# Personal preferences for ls output
alias ls='ls -hN --color=auto --group-directories-first'
alias la='ls -lahN'
alias ll='la'

# Output currently connected wifi pass
alias wifi-pw='nmcli device wifi show'

# Additional .local/bin scripts to path
export PATH="$PATH:~/.local/bin:/usr/bin:/usr/sbin:/opt/nvim-linux64/bin"
export PATH=$PATH:/usr/local/go/bin

# Menu to change to project directory
alias cdproj='cd ~/Documents/projects/$(ls ~/Documents/projects | fzf --height 20%)'
alias cdporj='cdproj'

# Menu to change to personal directory
alias cdpersonal='cd ~/Documents/personal/$(ls ~/Documents/personal | fzf --height 20%)'

# Menu to change to config directory
alias cdconfig='cd ~/.config/$(ls ~/.config | fzf --height 20%)'

# Menu to pick tmux session
alias cdsess='smug start $(smug list | fzf --height 20%) --attach'
alias cdess='cdsess'
alias ts='tmux-sessionizer'

# Personal scripts alias for typos or more shortcuts
alias rrr='restart-on-stop'
alias s='ssh-aws'

# Clipboard interactions
alias clip-copy='xclip -selection clipboard'
alias clip='clip-copy'
alias clip-paste='xclip -selection clipboard -o'
alias clip-decode='xclip -selection clipboard -o | base64 -d'

# Utility aliases of existing binaries
alias python='python3'
alias docker-compose="docker compose"
alias dcu="docker compose up"
alias dcs="docker compose stop"
alias bat='batcat'
alias ta='tmux attach'
alias sb='supabase'
alias tf='terraform'

# git aliases
alias gs="git status" 

_git_checkout_fzf() {
  local branch
  branch=$(
    git for-each-ref --sort=-committerdate \
      --format="%(refname:short)" refs/remotes/origin \
    | sed "s|origin/||" \
    | fzf --height 40%
  ) || return 0   # gracefully abort if Ctrl-C/Esc

  if [ -n "$branch" ]; then
    git checkout "$branch"
  else
    echo "No branch selected."
  fi
}
alias gcf="_git_checkout_fzf"

# Pick AWS profile
awsuse() {
    local profile
    local config="${AWS_CONFIG_FILE:-$HOME/.aws/config}"

    profile=$(
        aws configure list-profiles |
        sort |
        fzf \
          --prompt="Profile > " \
          --height=50% \
          --reverse \
          --border \
          --preview "awk '
            \$0 == \"[profile {}]\" {p=1; print; next}
            p && /^\[/ {exit}
            p {print}
        ' \"$config\""
    ) || return

    export AWS_PROFILE="$profile"

    echo "Switched to $AWS_PROFILE"

    aws sts get-caller-identity \
        --query 'Account' \
        --output text 2>/dev/null \
        | xargs -I{} echo "Account: {}"
}

# Bookmarks
alias bm="~/.local/bin/bookmarks.sh"
alias b="~/.local/bin/bookmarks.sh"

# Use z instead of cd
alias cd='z'

# Additional bind keys for zsh
if [[ "$SHELL" == *"zsh" ]]; then
